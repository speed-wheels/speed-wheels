---
layout: base.njk
---
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"OnlineStore","name":{{ site.name | json | safe }},"url":"{{ site.url }}/","description":{{ site.description | json | safe }},"logo":"{{ site.url }}/assets/logo.png","email":"{{ site.email }}","sameAs":["{{ site.instagram }}"],"areaServed":"IN"}
</script>
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">For die-cast collectors across India</p>
      <h1>Collect. Display. <em>Repeat.</em></h1>
      <p class="lead">Hot Wheels, Majorette and Mini GT die-cast cars, plus our own 3D-printed stands to show them off.</p>
      <div class="actions">
        <a class="btn btn-pay" href="/shop/">Shop now</a>
        <a class="btn btn-ghost" href="/collections/">Browse collections</a>
      </div>
    </div>
    {% set hero = collections.products[1] or collections.products[0] %}
    <a class="hero-img" href="{{ hero.url }}">{% img hero.data.image, hero.data.title, "(min-width: 900px) 45vw, 100vw", "", true %}</a>
  </div>
</section>
<section class="wrap perks" aria-label="Why Speed Wheels">
  <div><strong>Genuine die-cast</strong><span>Hot Wheels, Majorette, Mini GT and more</span></div>
  <div><strong>Ships across India</strong><span>{% if shipping.freeAbove %}Free shipping above {{ shipping.freeAbove | inr }}{% else %}Tracked delivery to your door{% endif %}</span></div>
  <div><strong>Pay your way</strong><span>UPI, cards, netbanking and wallets via Razorpay</span></div>
  <div><strong>Track your order</strong><span>Live status and courier tracking</span></div>
</section>
<section class="wrap">
  <div class="section-head"><h2>Shop by collection</h2><a href="/collections/">All collections →</a></div>
  {% include "collection-tiles.njk" %}
</section>
<section class="wrap">
  <div class="section-head"><h2>Best sellers</h2><a href="/shop/">View all →</a></div>
  <ul class="grid">{% asyncEach p in collections.products | featured %}{% include "product-card.njk" %}{% endeach %}</ul>
</section>
<section class="wrap band">
  <div>
    <h2>Got a collection that needs a custom display?</h2>
    <p>Tell us how many cars you have and where you want to put them. We'll design and print a stand to fit.</p>
  </div>
  <a class="btn btn-pay" href="{{ site.instagram }}" target="_blank" rel="noopener">Message us on Instagram</a>
</section>
