<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " | " + site.name) if title and page.url != "/" else (site.name + " | " + site.tagline) %}
{%- set pageDesc = description or summary or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ page.url | absUrl(site.url) }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="theme-color" content="#17181b">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{{ 'product' if price else 'website' }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ page.url | absUrl(site.url) }}">
<meta property="og:image" content="{{ (image or '/assets/og.jpg') | absUrl(site.url) }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/style.css">
{% block schema %}{% endblock %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label="{{ site.name }} home">{% include "logo.njk" %}<span>SPEED<b>WHEELS</b></span></a>
    <nav aria-label="Main">
      <a href="/shop/" {% if page.url.startsWith('/shop') or page.url.startsWith('/products') %}aria-current="page"{% endif %}>Shop</a>
      <a href="/collections/" {% if page.url.startsWith('/collections') %}aria-current="page"{% endif %}>Collections</a>
      <a href="/cart/" class="cart-link" aria-label="Cart" {% if page.url == '/cart/' %}aria-current="page"{% endif %}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.4 10.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 8H6.2M9 20h.01M17 20h.01"/></svg>
        <span class="cart-count" data-cart-count hidden>0</span>
      </a>
    </nav>
  </div>
  <div class="chequer" aria-hidden="true"></div>
</header>
<main id="main">
{% block content %}{{ content | safe }}{% endblock %}
</main>
<footer class="site-footer">
  <div class="chequer" aria-hidden="true"></div>
  <div class="wrap footer-grid">
    <div>
      <a class="brand" href="/">{% include "logo.njk" %}<span>SPEED<b>WHEELS</b></span></a>
      <p>{{ site.tagline }}. Shipped across India.</p>
      <p><a href="{{ site.instagram }}" rel="noopener" target="_blank">Instagram {{ site.instagramHandle }}</a></p>
    </div>
    <div>
      <h2>Shop</h2>
      <ul><li><a href="/shop/">All products</a></li>{% for c in collections.shopCollections %}<li><a href="{{ c.url }}">{{ c.data.title }}</a></li>{% endfor %}<li><a href="/cart/">Cart</a></li></ul>
    </div>
    <div>
      <h2>Help</h2>
      <ul>
        <li><a href="/track/">Track your order</a></li>
        <li><a href="/about/">About us</a></li>
        <li><a href="/contact/">Contact us</a></li>
        <li><a href="/shipping/">Shipping policy</a></li>
        <li><a href="/returns/">Returns &amp; refunds</a></li>
        <li><a href="/privacy/">Privacy policy</a></li>
        <li><a href="/terms/">Terms &amp; conditions</a></li>
      </ul>
    </div>
  </div>
  <p class="wrap fine">© {{ "now" | year }} {{ site.name }}. Speed Wheels is an independent retailer. Hot Wheels, Majorette, Mini GT and other brand names are trademarks of their respective owners; we are not affiliated with or endorsed by them.</p>
</footer>
<script src="/assets/shop.js" defer></script>
</body>
</html>
