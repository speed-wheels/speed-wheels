<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " | " + site.name) if title and page.url != "/" else (site.name + " | " + site.tagline) %}
{%- set pageDesc = description or summary or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ page.url | absUrl(site.url) }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="theme-color" content="#111318">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{{ 'product' if price else 'website' }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ page.url | absUrl(site.url) }}">
<meta property="og:image" content="{{ (image or '/assets/logo.png') | absUrl(site.url) }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="stylesheet" href="/assets/style.css">
{% block schema %}{% endblock %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar-row">
      <button class="icon-btn menu-btn" type="button" data-menu-open aria-controls="drawer" aria-expanded="false" aria-label="Open menu">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </button>
      <a class="brand" href="/" aria-label="{{ site.name }} home"><img src="/assets/logo-dark.png" alt="{{ site.name }}" width="68" height="52"></a>
      <a class="deliver" href="/shipping/"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9.5" r="2.5" fill="currentColor"/></svg><span><small>Delivering to</small><b>All of India</b></span></a>
      <form class="search" action="/search/" role="search" autocomplete="off">
        <label class="search-cat"><span class="sr">Search in</span><select name="c" aria-label="Search in"><option value="">All</option>{% for c in collections.shopCollections %}<option value="{{ c.fileSlug }}">{{ c.data.title }}</option>{% endfor %}</select></label>
        <input type="search" name="q" placeholder="Search Speed Wheels" aria-label="Search products" data-search-input>
        <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></button>
        <div class="suggest" data-suggest hidden></div>
      </form>
      <a class="hdr-link hide-sm" href="/wholesale/"><small>For shops</small><b>Wholesale</b></a>
      <a class="hdr-link hide-sm" href="/track/"><small>Returns</small><b>&amp; Orders</b></a>
      <a href="/cart/" class="cart-link" aria-label="Cart">
        <span class="cart-ico"><svg viewBox="0 0 32 32" width="34" height="34" aria-hidden="true"><path d="M2 5h4l3.2 14.2a1.5 1.5 0 0 0 1.5 1.2h13.6a1.5 1.5 0 0 0 1.5-1.1L28 10H8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="26" r="2" fill="currentColor"/><circle cx="23" cy="26" r="2" fill="currentColor"/></svg><span class="cart-count" data-cart-count>0</span></span><b class="hide-sm">Cart</b>
      </a>
    </div>
  </div>
  <nav class="subnav" aria-label="Shop menu">
    <div class="wrap subnav-row">
      <button type="button" class="subnav-all" data-menu-open aria-controls="drawer" aria-expanded="false"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>All</button>
      <a href="/shop/?sort=deals">Today's deals</a>
      {% for c in collections.shopCollections %}<a href="{{ c.url }}" {% if page.url == c.url %}aria-current="page"{% endif %}>{{ c.data.title }}</a>{% endfor %}
      <a href="/wholesale/" class="sub-hi">Wholesale</a>
      <a href="/shop/?sort=new">New arrivals</a>
      <a href="/track/">Track order</a>
      <a href="/contact/">Customer service</a>
    </div>
  </nav>
</header>
<div class="drawer-scrim" data-menu-close hidden></div>
<aside class="drawer" id="drawer" aria-label="Menu" hidden>
  <div class="drawer-head"><span class="drawer-hi">Hello, collector</span><button class="icon-btn" type="button" data-menu-close aria-label="Close menu">✕</button></div>
  <div class="drawer-body">
    <h2>Shop by collection</h2>
    <ul>{% for c in collections.shopCollections %}<li><a href="{{ c.url }}">{{ c.data.title }}<span aria-hidden="true">›</span></a></li>{% endfor %}<li><a href="/shop/">All products<span aria-hidden="true">›</span></a></li></ul>
    <h2>Trending</h2>
    <ul><li><a href="/shop/?sort=deals">Today's deals<span aria-hidden="true">›</span></a></li><li><a href="/shop/?sort=new">New arrivals<span aria-hidden="true">›</span></a></li><li><a href="/shop/?sort=price-asc">Under ₹500<span aria-hidden="true">›</span></a></li><li><a href="/wholesale/">Wholesale &amp; bulk orders<span aria-hidden="true">›</span></a></li></ul>
    <h2>Help &amp; settings</h2>
    <ul><li><a href="/track/">Track your order</a></li><li><a href="/cart/">Your cart</a></li><li><a href="/shipping/">Shipping</a></li><li><a href="/returns/">Returns &amp; refunds</a></li><li><a href="/contact/">Customer service</a></li><li><a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram {{ site.instagramHandle }}</a></li></ul>
  </div>
</aside>
<main id="main">
{% block content %}{{ content | safe }}{% endblock %}
</main>
<footer class="site-footer">
  <a class="to-top" href="#main">Back to top</a>
  <div class="wrap footer-grid">
    <div>
      <h2>Get to know us</h2>
      <ul><li><a href="/about/">About Speed Wheels</a></li><li><a href="/wholesale/">Wholesale &amp; bulk orders</a></li><li><a href="{{ site.instagram }}" rel="noopener" target="_blank">Instagram {{ site.instagramHandle }}</a></li><li><a href="/contact/">Contact us</a></li></ul>
    </div>
    <div>
      <h2>Shop</h2>
      <ul><li><a href="/shop/">All products</a></li>{% for c in collections.shopCollections %}<li><a href="{{ c.url }}">{{ c.data.title }}</a></li>{% endfor %}</ul>
    </div>
    <div>
      <h2>Let us help you</h2>
      <ul><li><a href="/track/">Track your order</a></li><li><a href="/cart/">Your cart</a></li><li><a href="/shipping/">Shipping policy</a></li><li><a href="/returns/">Returns &amp; refunds</a></li></ul>
    </div>
    <div>
      <h2>Policies</h2>
      <ul><li><a href="/privacy/">Privacy policy</a></li><li><a href="/terms/">Terms &amp; conditions</a></li></ul>
      <p class="pay-note">Secure payments by Razorpay<br>UPI · Cards · Netbanking · Wallets</p>
    </div>
  </div>
  <div class="footer-base">
    <a class="brand" href="/" aria-label="{{ site.name }} home"><img src="/assets/logo-dark.png" alt="{{ site.name }}" width="104" height="80" loading="lazy"></a>
    <p class="fine">© {{ "now" | year }} {{ site.name }}. Speed Wheels is an independent retailer. Hot Wheels, Majorette, Mini GT and other brand names are trademarks of their respective owners; we are not affiliated with or endorsed by them.</p>
  </div>
</footer>
<script src="/assets/shop.js" defer></script>
</body>
</html>
