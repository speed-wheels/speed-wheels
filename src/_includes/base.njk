<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " | " + site.name) if title and page.url != "/" else (site.name + " | " + site.tagline) %}
{%- set pageDesc = description or summary or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ page.url | absUrl(site.url) }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="theme-color" content="#17181b">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{{ 'product' if price else 'website' }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ page.url | absUrl(site.url) }}">
<meta property="og:image" content="{{ (image or '/assets/og.jpg') | absUrl(site.url) }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/style.css">
{% block schema %}{% endblock %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label="{{ site.name }} home">{% include "logo.njk" %}<span>SPEED<b>WHEELS</b></span></a>
    <nav aria-label="Main">
      <a href="/shop/" {% if page.url.startsWith('/shop') or page.url.startsWith('/products') %}aria-current="page"{% endif %}>Shop</a>
      <a href="/about/" {% if page.url == '/about/' %}aria-current="page"{% endif %}>About</a>
      <a href="/contact/" {% if page.url == '/contact/' %}aria-current="page"{% endif %}>Contact</a>
    </nav>
  </div>
  <div class="chequer" aria-hidden="true"></div>
</header>
<main id="main">
{% block content %}{{ content | safe }}{% endblock %}
</main>
<footer class="site-footer">
  <div class="chequer" aria-hidden="true"></div>
  <div class="wrap footer-grid">
    <div>
      <a class="brand" href="/">{% include "logo.njk" %}<span>SPEED<b>WHEELS</b></span></a>
      <p>{{ site.tagline }}. Printed to order in India.</p>
      <p><a href="{{ site.instagram }}" rel="noopener" target="_blank">Instagram {{ site.instagramHandle }}</a></p>
    </div>
    <div>
      <h2>Shop</h2>
      <ul><li><a href="/shop/">All stands</a></li>{% for p in collections.products | head(4) %}<li><a href="{{ p.url }}">{{ p.data.title }}</a></li>{% endfor %}</ul>
    </div>
    <div>
      <h2>Help</h2>
      <ul>
        <li><a href="/contact/">Contact us</a></li>
        <li><a href="/shipping/">Shipping policy</a></li>
        <li><a href="/returns/">Returns &amp; refunds</a></li>
        <li><a href="/privacy/">Privacy policy</a></li>
        <li><a href="/terms/">Terms &amp; conditions</a></li>
      </ul>
    </div>
  </div>
  <p class="wrap fine">© {{ "now" | year }} {{ site.name }}. Speed Wheels is an independent shop and is not affiliated with Mattel, Hot Wheels or any toy brand. Brand names are used only to describe compatible car sizes.</p>
</footer>
<a class="wa-float" href="https://wa.me/{{ site.whatsapp }}?text={{ ('Hi ' + site.name + ', I have a question.') | urlencode }}" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.6c-2 0-3.9-.5-5.6-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.1-1.2 2.8 1.2 3.2 1.4 3.5 2.4 3.7 5.8 5.1c2.2.9 3 1 4.1.8.7-.1 1.9-.8 2.2-1.5s.3-1.4.2-1.5-.3-.2-.6-.4z"/></svg>
</a>
</body>
</html>
