<ul class="tiles">
{%- for c in collections.shopCollections %}
  {%- set n = (collections.products | inCollection(c.fileSlug)).length %}
  <li><a class="tile tile-{{ loop.index0 % 4 }}" href="{{ c.url }}">
    {% if c.data.image %}{% img c.data.image, "", "(min-width: 900px) 25vw, 50vw", "tile-img" %}{% endif %}
    <span class="tile-name">{{ c.data.title }}</span>
    <span class="tile-count">{{ n }} item{{ "" if n == 1 else "s" }}</span>
  </a></li>
{%- endfor %}
</ul>
