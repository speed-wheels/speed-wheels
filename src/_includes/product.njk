{% extends "base.njk" %}
{% block schema %}
{%- set pageUrl = page.url | absUrl(site.url) %}
{%- set imgs = [image | absUrl(site.url)] %}{% for g in gallery %}{% set imgs = (imgs.push(g | absUrl(site.url)), imgs) %}{% endfor %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ title | json | safe }},
  "description": {{ summary | json | safe }},
  "sku": {{ sku | json | safe }},
  "image": {{ imgs | json | safe }},
  "brand": { "@type": "Brand", "name": {{ site.name | json | safe }} },
  "material": {{ material | json | safe }},
  "offers": {
    "@type": "Offer",
    "url": {{ pageUrl | json | safe }},
    "priceCurrency": "INR",
    "price": "{{ price }}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/{{ 'InStock' if inStock else 'OutOfStock' }}",
    "seller": { "@type": "Organization", "name": {{ site.name | json | safe }} },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IN" },
      "shippingRate": { "@type": "MonetaryAmount", "value": "{{ 0 if price >= site.freeShippingAbove else site.shippingFee }}", "currency": "INR" },
      "deliveryTime": { "@type": "ShippingDeliveryTime",
        "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 3, "unitCode": "DAY" },
        "transitTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 6, "unitCode": "DAY" } }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "IN",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 7,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  }
}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},
{"@type":"ListItem","position":2,"name":"Shop","item":"{{ site.url }}/shop/"},
{"@type":"ListItem","position":3,"name":{{ title | json | safe }},"item":{{ pageUrl | json | safe }}}]}
</script>
{% endblock %}
{% block content %}
<div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/shop/">Shop</a> / <span>{{ title }}</span></nav>
  <div class="product">
    <div class="gallery">
      <div class="main-img">{% img image, title, "(min-width: 900px) 50vw, 100vw", "", true %}</div>
      {% if gallery and gallery.length %}<div class="thumbs">{% for g in gallery %}{% img g, title + " photo " + (loop.index + 1), "(min-width: 900px) 25vw, 50vw" %}{% endfor %}</div>{% endif %}
    </div>
    <div class="buy">
      <h1>{{ title }}</h1>
      <p class="lead">{{ summary }}</p>
      {% set off = price | discount(mrp) %}
      <p class="price big">{{ price | inr }}{% if off %} <s>{{ mrp | inr }}</s> <span class="save">Save {{ off }}%</span>{% endif %}</p>
      <p class="muted small">Inclusive of all taxes. {% if price >= site.freeShippingAbove %}Free shipping.{% else %}Shipping {{ site.shippingFee | inr }}, free on orders above {{ site.freeShippingAbove | inr }}.{% endif %}</p>
      <p class="stock {{ 'in' if inStock else 'out' }}">{{ "In stock, ships in 1–3 days" if inStock else "Sold out right now." }}</p>

      <div class="order">
        {% if colours and colours.length %}<p class="small"><strong>Colours:</strong> {{ colours | join(", ") }}</p>{% endif %}
        {% if razorpayLink and inStock %}
        <a class="btn btn-pay btn-block" href="{{ razorpayLink }}" target="_blank" rel="noopener">Buy now · {{ price | inr }}</a>
        <p class="muted small">Secure checkout by Razorpay: UPI, cards, netbanking and wallets. Choose quantity{% if colours and colours.length %} and colour{% endif %} and enter your delivery address on the next page.</p>
        {% elif inStock %}
        <span class="btn btn-block btn-disabled" aria-disabled="true">Online ordering opens soon</span>
        <p class="muted small">Want it now? Email <a href="mailto:{{ site.email }}?subject={{ ('Order: ' + title) | urlencode }}">{{ site.email }}</a> or message us on <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a>.</p>
        {% else %}
        <span class="btn btn-block btn-disabled" aria-disabled="true">Sold out</span>
        <p class="muted small">Email <a href="mailto:{{ site.email }}?subject={{ ('Restock: ' + title) | urlencode }}">{{ site.email }}</a> to be told when it's back.</p>
        {% endif %}
      </div>

      <table class="specs">
        <tr><th>Holds</th><td>{{ capacity }}</td></tr>
        <tr><th>Car scale</th><td>{{ scale }}</td></tr>
        <tr><th>Size</th><td>{{ dimensions }}</td></tr>
        <tr><th>Material</th><td>{{ material }}</td></tr>
        <tr><th>SKU</th><td>{{ sku }}</td></tr>
      </table>
    </div>
  </div>
  <section class="prose desc"><h2>About this stand</h2>{{ content | safe }}</section>
  <section class="related">
    <h2>You may also like</h2>
    <ul class="grid">{% asyncEach p in collections.products | except(page.url) | head(4) %}{% include "product-card.njk" %}{% endeach %}</ul>
  </section>
</div>
{% endblock %}
