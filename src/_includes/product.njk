{% extends "base.njk" %}
{% block schema %}
{%- set pageUrl = page.url | absUrl(site.url) %}
{%- set imgs = [image | absUrl(site.url)] %}{% for g in gallery %}{% set imgs = (imgs.push(g | absUrl(site.url)), imgs) %}{% endfor %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ title | json | safe }},
  "description": {{ summary | json | safe }},
  "sku": {{ sku | json | safe }},
  "image": {{ imgs | json | safe }},
  "brand": { "@type": "Brand", "name": {{ (brand or site.name) | json | safe }} },
{% if material %}  "material": {{ material | json | safe }},
{% endif %}  "offers": {
    "@type": "Offer",
    "url": {{ pageUrl | json | safe }},
    "priceCurrency": "INR",
    "price": "{{ price }}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/{{ 'InStock' if inStock else 'OutOfStock' }}",
    "seller": { "@type": "Organization", "name": {{ site.name | json | safe }} },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IN" },
      "shippingRate": { "@type": "MonetaryAmount", "value": "{{ 0 if (shipping.freeAbove and price >= shipping.freeAbove) else shipping.defaultRate }}", "currency": "INR" },
      "deliveryTime": { "@type": "ShippingDeliveryTime",
        "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 3, "unitCode": "DAY" },
        "transitTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 6, "unitCode": "DAY" } }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "IN",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 7,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  }
}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},
{"@type":"ListItem","position":2,"name":"Shop","item":"{{ site.url }}/shop/"},
{"@type":"ListItem","position":3,"name":{{ title | json | safe }},"item":{{ pageUrl | json | safe }}}]}
</script>
{% endblock %}
{% block content %}
<div class="wrap">
  {% set crumbColl = collections.shopCollections | findBySlug(collection) %}<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / {% if crumbColl %}<a href="{{ crumbColl.url }}">{{ crumbColl.data.title }}</a>{% else %}<a href="/shop/">Shop</a>{% endif %} / <span>{{ title }}</span></nav>
  <div class="product">
    <div class="gallery">
      <div class="main-img">{% img image, title, "(min-width: 900px) 50vw, 100vw", "", true %}</div>
      {% if gallery and gallery.length %}<div class="thumbs">{% for g in gallery %}{% img g, title + " photo " + (loop.index + 1), "(min-width: 900px) 25vw, 50vw" %}{% endfor %}</div>{% endif %}
    </div>
    <div class="buy">
      <h1>{{ title }}</h1>
      <p class="lead">{{ summary }}</p>
      {% set off = price | discount(mrp) %}
      <p class="price big">{{ price | inr }}{% if off %} <s>{{ mrp | inr }}</s> <span class="save">Save {{ off }}%</span>{% endif %}</p>
      <p class="muted small">Inclusive of all taxes. {% if shipping.freeAbove and price >= shipping.freeAbove %}Free shipping.{% else %}Shipping from {{ shipping.defaultRate | inr }}{% if shipping.freeAbove %}, free on orders above {{ shipping.freeAbove | inr }}{% endif %}.{% endif %}</p>
      <p class="stock {{ 'in' if inStock else 'out' }}">{{ "In stock, ships in 1–3 days" if inStock else "Sold out right now." }}</p>

      {% if inStock %}
      <form class="order" id="add-to-cart" data-id="{{ page.fileSlug }}">
        {% if colours and colours.length %}
        <label>Colour
          <select name="colour">{% for c in colours %}<option>{{ c }}</option>{% endfor %}</select>
        </label>
        {% endif %}
        <label>Quantity</label>
        <div class="qty qty-input"><button type="button" data-qty-step="-1" aria-label="Decrease">−</button><input name="qty" type="number" min="1" max="20" value="1" inputmode="numeric" aria-label="Quantity"><button type="button" data-qty-step="1" aria-label="Increase">+</button></div>
        <div class="actions">
          <button class="btn btn-ghost" type="submit" value="add">Add to cart</button>
          <button class="btn btn-pay" type="submit" value="buy">Buy now</button>
        </div>
        <p class="muted small">Secure payment by Razorpay: UPI, cards, netbanking and wallets.</p>
      </form>
      {% else %}
      <div class="order">
        <span class="btn btn-block btn-disabled" aria-disabled="true">Sold out</span>
        <p class="muted small">Email <a href="mailto:{{ site.email }}?subject={{ ('Restock: ' + title) | urlencode }}">{{ site.email }}</a> to be told when it's back.</p>
      </div>
      {% endif %}

      {% set coll = collections.shopCollections | findBySlug(collection) %}
      <table class="specs">
        {% if coll %}<tr><th>Collection</th><td><a href="{{ coll.url }}">{{ coll.data.title }}</a></td></tr>{% endif %}
        {% if brand %}<tr><th>Brand</th><td>{{ brand }}</td></tr>{% endif %}
        {% if capacity %}<tr><th>Holds</th><td>{{ capacity }}</td></tr>{% endif %}
        {% if scale %}<tr><th>Scale</th><td>{{ scale }}</td></tr>{% endif %}
        {% if dimensions %}<tr><th>Size</th><td>{{ dimensions }}</td></tr>{% endif %}
        {% if material %}<tr><th>Material</th><td>{{ material }}</td></tr>{% endif %}
        {% if sku %}<tr><th>SKU</th><td>{{ sku }}</td></tr>{% endif %}
      </table>
    </div>
  </div>
  <section class="prose desc"><h2>Details</h2>{{ content | safe }}</section>
  <section class="related">
    <h2>You may also like</h2>
    <ul class="grid">{% asyncEach p in collections.products | except(page.url) | head(4) %}{% include "product-card.njk" %}{% endeach %}</ul>
  </section>
</div>
{% endblock %}
