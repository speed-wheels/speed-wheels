{% extends "base.njk" %}
{% block schema %}
{%- set pageUrl = page.url | absUrl(site.url) %}
{%- set imgs = [image | absUrl(site.url)] %}{% for g in gallery %}{% set imgs = (imgs.push(g | absUrl(site.url)), imgs) %}{% endfor %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ title | json | safe }},
  "description": {{ summary | json | safe }},
  "sku": {{ sku | json | safe }},
  "image": {{ imgs | json | safe }},
  "brand": { "@type": "Brand", "name": {{ (brand or site.name) | json | safe }} },
{% if material %}  "material": {{ material | json | safe }},
{% endif %}  "offers": {
    "@type": "Offer",
    "url": {{ pageUrl | json | safe }},
    "priceCurrency": "INR",
    "price": "{{ price }}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/{{ 'InStock' if inStock else 'OutOfStock' }}",
    "seller": { "@type": "Organization", "name": {{ site.name | json | safe }} },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IN" },
      "shippingRate": { "@type": "MonetaryAmount", "value": "{{ 0 if (shipping.freeAbove and price >= shipping.freeAbove) else shipping.defaultRate }}", "currency": "INR" },
      "deliveryTime": { "@type": "ShippingDeliveryTime",
        "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 3, "unitCode": "DAY" },
        "transitTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 6, "unitCode": "DAY" } }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "IN",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 7,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  }
}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},
{"@type":"ListItem","position":2,"name":"Shop","item":"{{ site.url }}/shop/"},
{"@type":"ListItem","position":3,"name":{{ title | json | safe }},"item":{{ pageUrl | json | safe }}}]}
</script>
{% endblock %}
{% block content %}
{%- set coll = collections.shopCollections | findBySlug(collection) %}
{%- set off = price | discount(mrp) %}
{%- set pics = image | allImages(gallery) %}
<div class="wrap pdp" data-product="{{ page.fileSlug }}">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › {% if coll %}<a href="{{ coll.url }}">{{ coll.data.title }}</a>{% else %}<a href="/shop/">Shop</a>{% endif %} › <span>{{ title }}</span></nav>
  <div class="pdp-grid">
    <div class="pdp-gallery" data-gallery>
      <div class="pdp-thumbs" role="tablist" aria-label="Photos">{% asyncEach im in pics %}<button type="button" class="{{ 'on' if loop.first }}" data-thumb="{{ loop.index0 }}" aria-label="Photo {{ loop.index }}">{% img im, "", "64px" %}</button>{% endeach %}</div>
      <div class="pdp-main">{% asyncEach im in pics %}<div class="pdp-pic{{ ' on' if loop.first }}" data-pic="{{ loop.index0 }}">{% img im, title + (" photo " + loop.index if not loop.first else ""), "(min-width: 900px) 40vw, 100vw", "", loop.first %}</div>{% endeach %}
        {% if off >= 10 %}<span class="deal-tag">{{ off }}% off</span>{% endif %}
      </div>
    </div>

    <div class="pdp-info">
      {% if brand %}<a class="pdp-brand" href="/search/?q={{ brand | urlencode }}">Brand: {{ brand }}</a>{% elif coll %}<a class="pdp-brand" href="{{ coll.url }}">Visit the {{ coll.data.title }} store</a>{% endif %}
      <h1>{{ title }}</h1>
      <hr>
      {% if off >= 10 %}<span class="deal-pill">Limited time deal</span>{% endif %}
      <div class="pdp-price">{% if off %}<span class="pp-pct">-{{ off }}%</span>{% endif %}<span class="pp-now big"><sup>₹</sup>{{ price | inr | replace("₹","") }}</span></div>
      {% if off %}<p class="pp-mrp">M.R.P.: <s>{{ mrp | inr }}</s></p>{% endif %}
      <p class="small">Inclusive of all taxes</p>
      <div class="pdp-perks">
        <div><span aria-hidden="true">🚚</span>{% if shipping.freeAbove and price >= shipping.freeAbove %}Free delivery{% else %}Free delivery above {{ shipping.freeAbove | inr }}{% endif %}</div>
        <div><span aria-hidden="true">🔒</span>Secure payment</div>
        <div><span aria-hidden="true">↩️</span>7-day returns</div>
        <div><span aria-hidden="true">📦</span>Tracked shipping</div>
      </div>
      <hr>
      {% if summary %}<h2 class="h-small">About this item</h2><ul class="pdp-bullets"><li>{{ summary }}</li>{% if capacity %}<li>Holds {{ capacity }}</li>{% endif %}{% if scale %}<li>Scale {{ scale }}</li>{% endif %}{% if dimensions %}<li>Size: {{ dimensions }}</li>{% endif %}{% if material %}<li>Material: {{ material }}</li>{% endif %}</ul>{% endif %}
    </div>

    <aside class="buybox">
      <div class="pp-now big"><sup>₹</sup>{{ price | inr | replace("₹","") }}</div>
      <p class="small">{% if shipping.freeAbove and price >= shipping.freeAbove %}<b>FREE delivery</b>{% else %}Delivery {{ shipping.defaultRate | inr }}, <b>FREE</b> on orders above {{ shipping.freeAbove | inr }}{% endif %} <span class="delivery-est" data-eta="{{ shipping.dispatchDays }}|{{ shipping.deliveryDays }}"></span></p>
      <p class="small muted">Ships to all of India</p>
      <p class="stock {{ 'in' if inStock else 'out' }}">{{ "In stock" if inStock else "Currently unavailable" }}</p>
      {% if inStock %}
      <form class="order" id="add-to-cart" data-id="{{ page.fileSlug }}">
        {% if colours and colours.length %}
        <fieldset class="swatches"><legend>Colour: <b data-colour-name>{{ colours[0] }}</b></legend>
          {% for c in colours %}<label><input type="radio" name="colour" value="{{ c }}" {% if loop.first %}checked{% endif %}><span>{{ c }}</span></label>{% endfor %}
        </fieldset>
        {% endif %}
        <label class="qty-sel">Quantity: <select name="qty">{% for n in range(1, 11) %}<option>{{ n }}</option>{% endfor %}</select></label>
        <button class="btn btn-cart btn-block" type="submit" value="add">Add to Cart</button>
        <button class="btn btn-pay btn-block" type="submit" value="buy">Buy Now</button>
      </form>
      {% else %}
      <p class="small">Email <a href="mailto:{{ site.email }}?subject={{ ('Restock: ' + title) | urlencode }}">{{ site.email }}</a> and we'll tell you when it's back.</p>
      {% endif %}
      {% if collection == "3d-printed-stands" %}<p class="wholesale-note">Buying for a shop? <a href="/wholesale/">Get wholesale prices</a> by email.</p>{% endif %}
      <table class="seller"><tr><th>Payment</th><td>Secure transaction</td></tr><tr><th>Ships from</th><td>{{ site.name }}</td></tr><tr><th>Sold by</th><td>{{ site.name }}</td></tr><tr><th>Returns</th><td><a href="/returns/">7-day returns</a></td></tr></table>
    </aside>
  </div>

  <section class="pdp-section">
    <h2>Product information</h2>
    <table class="specs">
      {% if coll %}<tr><th>Collection</th><td><a href="{{ coll.url }}">{{ coll.data.title }}</a></td></tr>{% endif %}
      {% if brand %}<tr><th>Brand</th><td>{{ brand }}</td></tr>{% endif %}
      {% if capacity %}<tr><th>Holds</th><td>{{ capacity }}</td></tr>{% endif %}
      {% if scale %}<tr><th>Scale</th><td>{{ scale }}</td></tr>{% endif %}
      {% if dimensions %}<tr><th>Size</th><td>{{ dimensions }}</td></tr>{% endif %}
      {% if material %}<tr><th>Material</th><td>{{ material }}</td></tr>{% endif %}
      {% if colours and colours.length %}<tr><th>Options</th><td>{{ colours | join(", ") }}</td></tr>{% endif %}
      {% if sku %}<tr><th>Item code</th><td>{{ sku }}</td></tr>{% endif %}
      <tr><th>Dispatch</th><td>{{ shipping.dispatchDays }}</td></tr>
    </table>
  </section>
  {% if content | trim %}<section class="pdp-section prose-in"><h2>Product description</h2>{{ content | safe }}</section>{% endif %}
</div>
{% set rowTitle = "Products related to this item" %}{% set rowLink = coll.url if coll else "/shop/" %}{% set rowItems = collections.products | except(page.url) %}
{% include "carousel.njk" %}
<section class="wrap row-box" data-recent hidden aria-label="Recently viewed">
  <div class="row-head"><h2>Your browsing history</h2></div>
  <div class="carousel" data-carousel><button class="car-btn prev" type="button" aria-label="Scroll left" data-car="-1">‹</button><ul class="car-track" data-recent-track></ul><button class="car-btn next" type="button" aria-label="Scroll right" data-car="1">›</button></div>
</section>
{% endblock %}
